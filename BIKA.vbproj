<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>BIKA</RootNamespace>
    <AssemblyName>SI-BIKA</AssemblyName>
    <StartupObject>Sub Main</StartupObject>
    <UseWindowsForms>true</UseWindowsForms>
    <MyType>WindowsFormsWithCustomSubMain</MyType>
    <OptionStrict>Off</OptionStrict>
    <OptionInfer>On</OptionInfer>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Import Include="System.Data" />
    <Import Include="System.Drawing" />
    <Import Include="System.Windows.Forms" />
    <Import Include="System.Threading.Tasks" />
    <Import Include="System.Collections.Generic" />
  </ItemGroup>
  <!-- Ganti versi dengan versi package yang sudah Anda pakai/restore. Krypton & ReaLTaiizor tidak dipakai (hindari bentrok tema dengan MaterialSkin). -->
  <ItemGroup>
    <PackageReference Include="Supabase" Version="*" />
    <PackageReference Include="MaterialSkin.2" Version="*" />
    <PackageReference Include="FontAwesome.Sharp" Version="*" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WinForms" Version="*-*" />
    <PackageReference Include="QuestPDF" Version="*" />
    <PackageReference Include="CsvHelper" Version="*" />
  </ItemGroup>
  <ItemGroup>
    <None Update="appsettings.json"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
  </ItemGroup>
</Project>
